# Graphics Expert: Cloudflare Pages configuration
#
# These are NOT read from a .env file in production. Add them in the Cloudflare dashboard:
#   Workers & Pages -> graphics-expert -> Settings -> Variables and Secrets
# For local testing with `npm run pages:dev`, copy this file to `.dev.vars` and fill in real values.
# Never commit real values to GitHub.

# Owner e-mail used to sign in to /admin (required)
ADMIN_EMAIL="graphicsexpert65@gmail.com"

# One-time bootstrap password (required for the first sign-in, 12+ characters, store as a Secret).
# It is hashed into the database on first sign-in; after that change it from Admin -> Settings.
ADMIN_PASSWORD="CHANGE_ME_TO_A_LONG_UNIQUE_PASSWORD"

# Random string (64+ characters) used to sign admin sessions (required, store as a Secret).
# Generate one with:  openssl rand -hex 32
SESSION_SECRET="CHANGE_ME_64_CHAR_RANDOM_HEX"

# Public site address, used in sitemap.xml / robots.txt / canonical tags (optional).
SITE_URL="https://graphics-expert.pages.dev"

# Maximum size of one uploaded design file in MB (optional, default 90, Cloudflare free plan limit is 100).
MAX_UPLOAD_SIZE_MB="90"

# Bindings (set under Settings -> Bindings, not as variables):
#   D1 database    variable name: DB
#   R2 bucket      variable name: BUCKET
